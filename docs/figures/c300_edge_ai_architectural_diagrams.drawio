          <!-- Title Banner -->
          <mxCell id="p3_t1" value="Xiaomi Smart Camera C300: Physical Hardware Boundary Compliance Gating Matrix" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=#2c3e50;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="20" width="1220" height="40" as="geometry" />
          </mxCell>

          <!-- FLASH CONTAINER -->
          <mxCell id="p3_c_flash" value="GATE 1: 16 MB SPI NOR FLASH STORAGE PARTITIONING (GigaDevice GD25Q128E)&#xa;Maximum Available SquashFS Storage for AI Model Weights: 5.50 MB (Critical Ceiling: 6.00 MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9f9;strokeColor=#2980b9;strokeWidth=2;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1b4f72;spacingTop=10;" vertex="1" parent="1">
            <mxGeometry x="50" y="80" width="580" height="580" as="geometry" />
          </mxCell>

          <mxCell id="f_part_map" value="&lt;b&gt;Flash Partition Layout:&lt;/b&gt; U-Boot (0.25M) | Linux Kernel (2.75M) | Rootfs (5.5M) | Config (1.5M) | AI Partition (5.5M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#3498db;fontSize=10;fontColor=#2c3e50;" vertex="1" parent="1">
            <mxGeometry x="70" y="130" width="540" height="30" as="geometry" />
          </mxCell>

          <!-- Flash Model Bars -->
          <mxCell id="f_m1" value="&lt;b&gt;YOLOv8n-320 (INT8): 3.31 MB&lt;/b&gt; [PASS - Safe margin +2.19 MB]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4efdf;strokeColor=#27ae60;strokeWidth=2;align=left;fontSize=11;fontColor=#145a32;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="70" y="180" width="310" height="45" as="geometry" />
          </mxCell>

          <mxCell id="f_m2" value="&lt;b&gt;EfficientDet-Lite0 (INT8): 4.39 MB&lt;/b&gt; [PASS - Margin +1.11 MB]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4efdf;strokeColor=#27ae60;strokeWidth=1.5;align=left;fontSize=11;fontColor=#145a32;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="70" y="240" width="390" height="45" as="geometry" />
          </mxCell>

          <mxCell id="f_limit" value="5.5 MB Partition Limit" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#c0392b;fillColor=#fdedec;rounded=1;strokeColor=#e74c3c;" vertex="1" parent="1">
            <mxGeometry x="420" y="300" width="130" height="20" as="geometry" />
          </mxCell>

          <mxCell id="f_m3" value="&lt;b&gt;SSD MobileNetV2 (INT8): 5.93 MB&lt;/b&gt; [WARN - Exceeds 5.5MB standard partition by 0.43MB]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f39c12;strokeWidth=2;align=left;fontSize=11;fontColor=#7e5109;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="70" y="330" width="510" height="45" as="geometry" />
          </mxCell>

          <mxCell id="f_m4" value="&lt;b&gt;YOLOv8n (FP32): 12.17 MB&lt;/b&gt; [FATAL FAIL - Exceeds budget by +6.67 MB]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9ebea;strokeColor=#e74c3c;strokeWidth=1.5;align=left;fontSize=10.5;fontColor=#78281f;spacingLeft=10;" vertex="1" parent="1">
            <mxGeometry x="70" y="390" width="540" height="40" as="geometry" />

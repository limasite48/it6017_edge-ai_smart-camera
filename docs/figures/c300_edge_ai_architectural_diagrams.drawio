          <!-- Title Banner -->
          <mxCell id="p2_t1" value="Xiaomi Smart Camera C300: 5.00W Electrical Power Budget &amp; Fanless Thermal Breakdown" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=#2c3e50;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="20" width="1220" height="40" as="geometry" />
          </mxCell>

          <!-- Outer 5.0W Container -->
          <mxCell id="p2_c5w" value="TOTAL CAMERA ELECTRICAL BUDGET: 5.00 WATTS (5V / 1.0A DC Micro-USB Rating)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9f9;strokeColor=#34495e;strokeWidth=2;align=center;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#2c3e50;spacingTop=12;" vertex="1" parent="1">
            <mxGeometry x="50" y="80" width="1200" height="340" as="geometry" />
          </mxCell>

          <!-- Stacked Subsystem Blocks -->
          <!-- Subsystem 1: Base SoC -->
          <mxCell id="sub1" value="&lt;b&gt;Base SoC, Linux &amp; Wi-Fi&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size: 16px;'&gt;&lt;b&gt;1.80 W&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;(36.0% of Total Budget)&lt;br/&gt;&lt;br/&gt;MIPS Core baseline, Linux 4.9 Kernel, Wi-Fi 4 802.11b/g/n Baseband, Crystal Oscillators." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34495e;strokeColor=#1a252f;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="80" y="140" width="220" height="200" as="geometry" />
          </mxCell>

          <!-- Subsystem 2: CMOS & ISP/VPU -->
          <mxCell id="sub2" value="&lt;b&gt;SC3336 CMOS + ISP / VPU&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size: 16px;'&gt;&lt;b&gt;0.60 W&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;(12.0% of Total Budget)&lt;br/&gt;&lt;br/&gt;SmartSens 2K Sensor, Ingenic Hardware ISP, 2304x1296 H.265 Hardware Encoder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2980b9;strokeColor=#1b4f72;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="320" y="140" width="180" height="200" as="geometry" />
          </mxCell>

          <!-- Subsystem 3: YOLOv8n INT8 AI Engine -->
          <mxCell id="sub3" value="&lt;b&gt;YOLOv8n INT8 AI Engine&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size: 18px;'&gt;&lt;b&gt;0.32 W&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;(6.4% of Total Budget)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;XBurst SIMD128 Vector Ops&lt;/b&gt;&lt;br/&gt;Runs at 28.1 FPS continuously.&lt;br/&gt;Consumes only 32% of allowable 1.0W AI thermal headroom!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27ae60;strokeColor=#145a32;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="520" y="140" width="210" height="200" as="geometry" />
          </mxCell>

          <!-- Subsystem 4: PTZ Motors & IR LEDs -->
          <mxCell id="sub4" value="&lt;b&gt;PTZ Steppers &amp; IR LEDs&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size: 16px;'&gt;&lt;b&gt;1.10 W&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;(22.0% of Total Budget)&lt;br/&gt;&lt;br/&gt;Dual Pan-Tilt Stepper Motors (Active rotation), 6x 940nm Infrared Night-Vision LEDs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e67e22;strokeColor=#a04000;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="750" y="140" width="200" height="200" as="geometry" />
          </mxCell>

          <!-- Subsystem 5: Safety Headroom -->
          <mxCell id="sub5" value="&lt;b&gt;Headroom Margin&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style='font-size: 16px;'&gt;&lt;b&gt;1.18 W&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;(23.6% of Budget)&lt;br/&gt;&lt;br/&gt;Voltage ripple guard, USB cable IR drop, transient motor acceleration spikes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#95a5a6;strokeColor=#7f8c8d;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="970" y="140" width="250" height="200" as="geometry" />
          </mxCell>

          <!-- 1.0W Thermal Ceiling Indicator -->
          <mxCell id="thermal_line" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#c0392b;dashed=1;" edge="1" parent="1">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
              <mxPoint x="740" y="370" as="sourcePoint" />
              <mxPoint x="740" y="110" as="targetPoint" />
            </mxGeometry>
          </mxCell>
          <mxCell id="thermal_text" value="MAX SUSTAINED AI COMPUTE CEILING (1.00 W)&#xa;Sealed Fanless Plastic Dome Thermal Dissipation Limit" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#c0392b;fillColor=#fdedec;rounded=1;strokeColor=#e74c3c;" vertex="1" parent="1">
            <mxGeometry x="540" y="360" width="350" height="30" as="geometry" />
          </mxCell>

          <!-- Comparison Box: Edge AI vs Cloud Streaming -->
          <mxCell id="cmp_box1" value="&lt;b&gt;EDGE AI VS. LEGACY CLOUD STREAMING COMPARISON&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;strokeWidth=1.5;align=center;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#1b4f72;spacingTop=10;" vertex="1" parent="1">
            <mxGeometry x="50" y="450" width="1200" height="240" as="geometry" />
          </mxCell>

          <mxCell id="cmp_cloud" value="&lt;b&gt;LEGACY XIAOMI CLOUD STREAMING PIPELINE:&lt;/b&gt;&lt;br/&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Wi-Fi Transmitter Power:&lt;/b&gt; Continuously active (~0.85 W continuous RF transmission to AWS / Xiaomi cloud).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Network Bandwidth:&lt;/b&gt; Consumes 2.5 Mbps continuous upstream per camera.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Detection Latency:&lt;/b&gt; 2.5 to 5.0 seconds (encoding + buffer + uplink + cloud queue + cloud AI + push alert).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Privacy Risk:&lt;/b&gt; Raw video leaves the local network; relies on proprietary Xiaomi cloud subscription.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e9;strokeColor=#e67e22;align=left;verticalAlign=top;fontSize=11;fontColor=#7e5109;spacing=10;" vertex="1" parent="1">
            <mxGeometry x="80" y="490" width="530" height="180" as="geometry" />
          </mxCell>

          <mxCell id="cmp_edge" value="&lt;b&gt;PROPOSED INGENIC T31N ON-DEVICE YOLOv8n PIPELINE:&lt;/b&gt;&lt;br/&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;AI Compute Power:&lt;/b&gt; Only 0.32 W (&lt;font color='#27ae60'&gt;&lt;b&gt;62.3% lower power&lt;/b&gt;&lt;/font&gt; than continuous Wi-Fi uplink).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Network Bandwidth:&lt;/b&gt; 0 kbps baseline. Transmits only 1 KB JSON payload upon confirmed human detection.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Detection Latency:&lt;/b&gt; &lt;font color='#27ae60'&gt;&lt;b&gt;35.6 milliseconds (Instantaneous on-device response)&lt;/b&gt;&lt;/font&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Privacy &amp; Security:&lt;/b&gt; 100% Zero-Trust local processing; video never leaves the camera.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f8f5;strokeColor=#27ae60;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#145a32;spacing=10;" vertex="1" parent="1">
            <mxGeometry x="640" y="490" width="580" height="180" as="geometry" />
          </mxCell>

        </root>
      </mxGraphModel>
    </diagram>
    
    <diagram id="hardware_gating" name="3. Hardware Gating Matrix">
      <mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">

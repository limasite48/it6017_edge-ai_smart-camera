    <diagram id="pareto_frontier" name="1. Pareto Frontier &amp; Real-Time">
      <mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
        <root>
          <mxCell id="0" />
          <mxCell id="1" parent="0" />

          <!-- Title Banner -->
          <mxCell id="t1" value="Xiaomi Smart Camera C300 (Ingenic T31N): Accuracy vs. Latency Pareto Frontier" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=#2c3e50;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="20" width="1220" height="40" as="geometry" />
          </mxCell>

          <!-- Real-Time Shaded Zone -->
          <mxCell id="rt_zone" value="REAL-TIME EDGE PROCESSING REGION&#xa;(Latency &lt;= 50.0 ms | Throughput &gt;= 20 FPS SC3336 Native Stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f8f5;strokeColor=#27ae60;strokeWidth=2;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#145a32;spacingTop=12;" vertex="1" parent="1">
            <mxGeometry x="60" y="80" width="460" height="660" as="geometry" />
          </mxCell>

          <!-- Non Real-Time Zone -->
          <mxCell id="non_rt_zone" value="SUBSAMPLED / NON-REAL-TIME REGION (Requires 1-in-N Frame Dropping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#f39c12;strokeWidth=1;strokeDashed=1;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#7e5109;spacingTop=12;" vertex="1" parent="1">
            <mxGeometry x="540" y="80" width="720" height="660" as="geometry" />
          </mxCell>

          <!-- 20 FPS Gating Threshold Line -->
          <mxCell id="gating_line" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#c0392b;dashed=1;" edge="1" parent="1">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
              <mxPoint x="530" y="740" as="sourcePoint" />
              <mxPoint x="530" y="80" as="targetPoint" />
            </mxGeometry>
          </mxCell>
          <mxCell id="gating_label" value="20 FPS Real-Time Gating Boundary (50.0 ms)&#xa;Matches SmartSens SC3336 2K CMOS Native Clock" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#c0392b;fillColor=#fdedec;rounded=1;strokeColor=#e74c3c;" vertex="1" parent="1">
            <mxGeometry x="400" y="90" width="260" height="35" as="geometry" />
          </mxCell>

          <!-- WINNER CARD: YOLOv8n INT8 -->
          <mxCell id="c_yolo_int8" value="&lt;b&gt;YOLOv8n-320 (INT8) - PARETO OPTIMAL WINNER&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Projected T31N Latency:&lt;/b&gt; 35.6 ms (28.1 FPS) [REAL-TIME 1:1]&lt;br/&gt;&lt;b&gt;COCO Person Detection mAP@50:&lt;/b&gt; 0.448 (Leading accuracy)&lt;br/&gt;&lt;b&gt;Flash ROM Footprint:&lt;/b&gt; 3.31 MB (PASS vs 5.5 MB budget, +2.19 MB margin)&lt;br/&gt;&lt;b&gt;RAM Tensor Arena:&lt;/b&gt; 19.4 MB (PASS vs 22.0 MB budget, +2.60 MB margin)&lt;br/&gt;&lt;b&gt;Net AI Power:&lt;/b&gt; 0.322 W (Fits 1.0W fanless thermal ceiling)&lt;br/&gt;&lt;b&gt;Pareto Index:&lt;/b&gt; 0.6088 (3.43x higher than runner-up)&lt;br/&gt;&lt;b&gt;BOM Cost Impact:&lt;/b&gt; $0.00 (Zero hardware revision needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4efdf;strokeColor=#27ae60;strokeWidth=3;align=left;verticalAlign=top;fontSize=11;fontColor=#145a32;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="90" y="160" width="400" height="150" as="geometry" />
          </mxCell>

          <!-- CARD: EfficientDet-Lite0 INT8 -->
          <mxCell id="c_eff_int8" value="&lt;b&gt;EfficientDet-Lite0 (INT8) - UNFEASIBLE (RAM OOM)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Projected T31N Latency:&lt;/b&gt; 53.3 ms (18.8 FPS) [Near Real-Time]&lt;br/&gt;&lt;b&gt;COCO Person Detection mAP@50:&lt;/b&gt; 0.136 (Severe BiFPN degradation)&lt;br/&gt;&lt;b&gt;Flash ROM Footprint:&lt;/b&gt; 4.39 MB (PASS vs 5.5 MB budget)&lt;br/&gt;&lt;b&gt;RAM Tensor Arena:&lt;/b&gt; 24.4 MB (&lt;font color='#c0392b'&gt;&lt;b&gt;FATAL FAIL: Exceeds 22MB ceiling&lt;/b&gt;&lt;/font&gt;)&lt;br/&gt;&lt;b&gt;Failure Mode:&lt;/b&gt; Concurrent BiFPN tensors trigger Linux OOM panic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9ebea;strokeColor=#e74c3c;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=10.5;fontColor=#78281f;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="560" y="160" width="340" height="130" as="geometry" />
          </mxCell>

          <!-- CARD: SSD MobileNetV2 INT8 -->
          <mxCell id="c_ssd_int8" value="&lt;b&gt;SSD MobileNetV2 (INT8) - FEASIBLE WITH STRIDE&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Projected T31N Latency:&lt;/b&gt; 171.3 ms (5.8 FPS) [Requires 1/4 Frame Stride]&lt;br/&gt;&lt;b&gt;COCO Person Detection mAP@50:&lt;/b&gt; 0.402 (High accuracy)&lt;br/&gt;&lt;b&gt;Flash ROM Footprint:&lt;/b&gt; 5.93 MB (&lt;font color='#d35400'&gt;&lt;b&gt;WARN: Exceeds 5.5MB standard partition&lt;/b&gt;&lt;/font&gt;)&lt;br/&gt;&lt;b&gt;RAM Tensor Arena:&lt;/b&gt; 20.3 MB (PASS vs 22.0 MB budget)&lt;br/&gt;&lt;b&gt;Pareto Index:&lt;/b&gt; 0.1777 (Runner-up, but slow frame rate)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f39c12;strokeWidth=2;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7e5109;spacing=8;" vertex="1" parent="1">
            <mxGeometry x="560" y="320" width="340" height="130" as="geometry" />
          </mxCell>

          <!-- CARD: YOLOv8n FP32 -->
          <mxCell id="c_yolo_fp32" value="&lt;b&gt;YOLOv8n-320 (FP32 Baseline)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;T31N Latency:&lt;/b&gt; 227.7 ms (4.4 FPS) | &lt;b&gt;mAP50:&lt;/b&gt; 0.473&lt;br/&gt;&lt;b&gt;Flash:&lt;/b&gt; 12.17 MB (&lt;font color='#c0392b'&gt;FAIL&lt;/font&gt;) | &lt;b&gt;RAM:&lt;/b&gt; 33.7 MB (&lt;font color='#c0392b'&gt;FAIL&lt;/font&gt;)&lt;br/&gt;&lt;i&gt;MIPS32 scalar emulation bottleneck; exceeds both memory gates.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaeded;strokeColor=#95a5a6;strokeWidth=1;align=left;verticalAlign=top;fontSize=10;fontColor=#34495e;spacing=6;" vertex="1" parent="1">
            <mxGeometry x="930" y="160" width="310" height="95" as="geometry" />
          </mxCell>

          <!-- CARD: EfficientDet FP32 -->
          <mxCell id="c_eff_fp32" value="&lt;b&gt;EfficientDet-Lite0 (FP32 Baseline)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;T31N Latency:&lt;/b&gt; 332.5 ms (3.0 FPS) | &lt;b&gt;mAP50:&lt;/b&gt; 0.049&lt;br/&gt;&lt;b&gt;Flash:&lt;/b&gt; 13.20 MB (&lt;font color='#c0392b'&gt;FAIL&lt;/font&gt;) | &lt;b&gt;RAM:&lt;/b&gt; 31.2 MB (&lt;font color='#c0392b'&gt;FAIL&lt;/font&gt;)&lt;br/&gt;&lt;i&gt;Severe scalar slowdown; cannot fit in 16MB SPI NOR Flash.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaeded;strokeColor=#95a5a6;strokeWidth=1;align=left;verticalAlign=top;fontSize=10;fontColor=#34495e;spacing=6;" vertex="1" parent="1">
            <mxGeometry x="930" y="275" width="310" height="95" as="geometry" />
          </mxCell>

          <!-- CARD: SSD MobileNet FP32 -->
          <mxCell id="c_ssd_fp32" value="&lt;b&gt;SSD MobileNetV2 (FP32 Baseline)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;T31N Latency:&lt;/b&gt; 1120.0 ms (0.89 FPS) | &lt;b&gt;mAP50:&lt;/b&gt; 0.395&lt;br/&gt;&lt;b&gt;Flash:&lt;/b&gt; 23.24 MB (&lt;font color='#c0392b'&gt;FATAL FAIL&lt;/font&gt;) | &lt;b&gt;RAM:&lt;/b&gt; 37.7 MB (&lt;font color='#c0392b'&gt;FAIL&lt;/font&gt;)&lt;br/&gt;&lt;i&gt;Entire model binary exceeds the complete 16MB Flash capacity.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaeded;strokeColor=#95a5a6;strokeWidth=1;align=left;verticalAlign=top;fontSize=10;fontColor=#34495e;spacing=6;" vertex="1" parent="1">
            <mxGeometry x="930" y="390" width="310" height="95" as="geometry" />
          </mxCell>

          <!-- Engineering Takeaway Box -->
          <mxCell id="box_takeaway" value="&lt;b&gt;CORE ENGINEERING CONCLUSION FOR SUB-TEAM 3 &amp; FINAL DEFENSE:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Only 1 Model is Deployable:&lt;/b&gt; YOLOv8n-320 INT8 is the sole architecture satisfying Real-Time Throughput (28.1 FPS &gt; 20 FPS), Flash Storage (3.31 MB &lt; 5.5 MB), and Working RAM (19.4 MB &lt; 22.0 MB).&lt;br/&gt;2. &lt;b&gt;Quantization Gain:&lt;/b&gt; INT8 quantization on YOLOv8n produces only a 2.5% mAP drop for a 72.8% file size reduction and 2.15x speedup.&lt;br/&gt;3. &lt;b&gt;Zero BOM Cost:&lt;/b&gt; Transforms a $29.99 dumb streaming camera into a secure, private edge AI detector without any hardware modification ($0.00)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf5fb;strokeColor=#2980b9;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#1b4f72;spacing=10;" vertex="1" parent="1">
            <mxGeometry x="90" y="520" width="1150" height="110" as="geometry" />
          </mxCell>

        </root>
      </mxGraphModel>
    </diagram>
    
    <diagram id="power_envelope" name="2. Subsystem Power &amp; Thermal">
      <mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
